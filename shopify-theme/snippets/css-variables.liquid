{%- comment -%} Injects theme settings as CSS custom properties. {%- endcomment -%}
{% style %}
  :root {
    --color-dark: {{ settings.color_dark | default: '#1c1917' }};
    --color-text: {{ settings.color_text | default: '#1c1917' }};
    --color-muted: {{ settings.color_muted | default: '#78716c' }};
    --color-bg: {{ settings.color_background | default: '#fafaf9' }};
    --color-surface: {{ settings.color_surface | default: '#f5f5f4' }};
    --color-border: {{ settings.color_border | default: '#e7e5e4' }};
    --color-accent: {{ settings.color_accent | default: '#2563eb' }};
    --color-dark-bg: {{ settings.color_dark_section_bg | default: '#1c1917' }};
    --color-dark-text: {{ settings.color_dark_section_text | default: '#ffffff' }};
    --page-width: {{ settings.page_width | default: 1280 }}px;
    --heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}
