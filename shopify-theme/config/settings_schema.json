        "default": "#1c1917"
      },
      {
        "type": "color",
        "id": "color_dark_section_text",
        "label": "Dark section text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings use Playfair Display and body text uses Inter, loaded from Google Fonts."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "checkbox",
        "id": "show_trust_badges",
        "label": "Show trust badges in footer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Open cart drawer when adding to cart",
        "default": true
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
