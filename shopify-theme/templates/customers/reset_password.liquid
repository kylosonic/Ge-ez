<div class="customer customer--narrow">
  <h1 class="customer__title">{{ 'customer.reset_password.title' | t }}</h1>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>

    <div class="field">
      <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirmation' | t }}</label>
      <input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
