<div class="customer customer--narrow" style="padding-top:96px">
  <div class="text-center">
    <h1 class="customer__title">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p style="color:var(--color-muted)">{{ shop.password_message }}</p>
    {%- endif -%}
  </div>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label class="field__label" for="StorePassword">Enter store password</label>
      <input class="field__input" type="password" name="password" id="StorePassword" autocomplete="current-password">
    </div>
    <button type="submit" class="btn btn--primary btn--full">Enter</button>
  {%- endform -%}
</div>
