<section class="section">
  <div class="page-width">
    <div class="faq" style="border-top:0;padding-top:0;margin-top:0">
      {%- if section.settings.heading != blank -%}
        <h3>{{ section.settings.heading }}</h3>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</svg>
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is the material?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our shirts are made from 100% premium Ethiopian cotton, known for its softness and durability.</p>"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What is the material?", "answer": "<p>Our shirts are made from 100% premium Ethiopian cotton, known for its softness and durability.</p>" } },
        { "type": "question", "settings": { "question": "How do I care for this item?", "answer": "<p>Machine wash cold with like colors. Tumble dry low or hang dry for best results. Do not bleach.</p>" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>We offer free returns within 30 days of purchase. Items must be unworn and in original condition.</p>" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship worldwide. Shipping times vary by location but typically take 7-14 business days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
