<section class="section--tight">
  <div class="page-width">
    <div class="trust-badges">
      {%- for block in section.blocks -%}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</svg>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield-check", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Returns" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shield-check"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Secure Payment" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield-check", "text": "Secure Payment" } },
        { "type": "badge", "settings": { "icon": "truck", "text": "Fast Shipping" } },
        { "type": "badge", "settings": { "icon": "refresh", "text": "Free Returns" } }
      ]
    }
  ]
}
{% endschema %}
