{%- liquid
  assign featured = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 8
-%}
<section class="section" id="shopping-grid">
  <div class="page-width">
    <div class="collection-toolbar">
      <div class="collection-toolbar__title">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and featured != blank -%}
        <a class="btn btn--secondary btn--sm" href="{{ featured.url }}">{{ 'collections.general.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if featured != blank and featured.products.size > 0 -%}
        {%- for product in featured.products limit: products_to_show -%}
          {% render 'product-card', product: product, show_quick_add: true %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__info">
              <div>
                <h3 class="product-card__title">Example product</h3>
                <p class="product-card__category">Category</p>
              </div>
              <div class="product-card__price"><span class="price"><span class="price__current">{{ 2900 | money }}</span></span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "All available items" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' button", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
