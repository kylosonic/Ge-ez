{%- liquid
  assign heading = section.settings.heading
-%}
<section class="section" id="categories">
  <div class="page-width">
    {%- if heading != blank -%}
      <div class="section__header">
        <h2>{{ heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p style="color:var(--color-muted);margin:0">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat = block.settings.collection
          assign cat_image = block.settings.image
          if cat_image == blank and cat != blank
            assign cat_image = cat.featured_image
            if cat_image == blank
              assign cat_image = cat.products.first.featured_media
            endif
          endif
          assign cat_title = block.settings.title
          if cat_title == blank and cat != blank
            assign cat_title = cat.title
          endif
          assign cat_text = block.settings.text
          if cat_text == blank and cat != blank
            assign cat_text = cat.description | strip_html | truncatewords: 6
          endif
          assign cat_url = block.settings.link
          if cat_url == blank and cat != blank
            assign cat_url = cat.url
          endif
        -%}
        <a class="category-card" href="{{ cat_url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if cat_image != blank -%}
            {{ cat_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 768px) 33vw, 100vw', alt: cat_title | escape
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="category-card__overlay">
            <h3>{{ cat_title | default: 'Collection' }}</h3>
            {%- if cat_text != blank -%}
              <p>{{ cat_text }}</p>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category list",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "text", "label": "Custom subtitle" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Category List" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "presets": [
    {
      "name": "Category list",
      "blocks": [
        { "type": "category", "settings": { "title": "Full Collection", "text": "Browse All Items" } },
        { "type": "category", "settings": { "title": "Shirts", "text": "Essential Tops" } },
        { "type": "category", "settings": { "title": "Hoodies", "text": "Cozy Comfort" } }
      ]
    }
  ]
}
{% endschema %}
