<section class="section">
  <div class="page-width">
    <div class="section__header">
      <h1>{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 9 -%}
      <div class="product-grid">
        {%- for article in blog.articles -%}
          <article class="product-card">
            <a class="product-card__media" href="{{ article.url }}">
              {%- if article.image -%}
                {{ article.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '200, 400, 800', sizes: '(min-width: 1024px) 33vw, 50vw', alt: article.title | escape
                }}
              {%- else -%}
                {{ 'blog-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="product-card__info">
              <div>
                <h3 class="product-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                <p class="product-card__category">{{ article.published_at | date: '%b %d, %Y' }}</p>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
