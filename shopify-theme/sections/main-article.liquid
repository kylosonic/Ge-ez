<article class="section">
  <div class="page-width" style="max-width:760px">
    <div class="section__header">
      <p class="section__eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1>{{ article.title }}</h1>
      {%- if article.author != blank -%}
        <p style="color:var(--color-muted)">By {{ article.author }}</p>
      {%- endif -%}
    </div>

    {%- if article.image -%}
      <div style="border-radius:var(--radius-lg);overflow:hidden;margin-bottom:32px">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 800, 1400', sizes: '100vw', alt: article.title | escape }}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div class="faq" style="margin-top:48px">
        <h3>{{ article.comments_count }} Comments</h3>
        {%- for comment in article.comments -%}
          <div class="faq__answer" style="border-radius:var(--radius-sm);border:1px solid var(--color-border);margin-bottom:12px">
            <p style="margin:0 0 4px"><strong>{{ comment.author }}</strong></p>
            <div class="rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}

        {%- form 'new_comment', article -%}
          {%- if form.errors -%}
            <div class="form-errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="field-row field-row--2">
            <div class="field">
              <label class="field__label" for="CommentAuthor">Name</label>
              <input class="field__input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required>
            </div>
            <div class="field">
              <label class="field__label" for="CommentEmail">Email</label>
              <input class="field__input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="CommentBody">Comment</label>
            <textarea class="field__textarea" name="comment[body]" id="CommentBody" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--primary">Post comment</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
